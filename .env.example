# ------------------------------------------------------------------
# Gold (XAUUSD) Hybrid Copy-Trading + AI Strategy Platform — env template
# Copy to .env and fill in. NEVER commit the real .env.
# ------------------------------------------------------------------

# --- Trading mode ---------------------------------------------------
# backtest | replay | paper | prop_eval | live
# The platform never defaults to live.
TRADING_MODE=paper
ACTIVE_PROP_PROFILE=default_demo

# --- Database -------------------------------------------------------
# DATABASE_URL is the base connection (SQLite works for local dev/testing).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# SUPABASE_DB_URL, when set, takes precedence over DATABASE_URL (managed Postgres).
SUPABASE_DB_URL=
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/gold_trader

# --- Execution driver -----------------------------------------------
# paper | ea | metaapi
EXECUTION_DRIVER=paper
# Shared secret the local MT5 EA must present to the bridge (X-API-Key or ?key=).
EA_API_KEY=
EA_ORDER_TIMEOUT_SECONDS=60

# --- Control plane --------------------------------------------------
# When set, mutating API endpoints (manual order, config, leaders, kill
# switch, copy-trading) require this key via X-API-Key or Authorization:
# Bearer. Leave empty ONLY on a trusted localhost.
OPS_API_KEY=

# --- Market data ----------------------------------------------------
# Symbols to watch. XAUUSD.gold for MT5 precious metals, XAUUSD for classic. Adjust to broker.
MARKET_SYMBOL=XAUUSD
MARKET_TIMEFRAME=M15
# MetaApi token (also used for market data on the same account)
METAAPI_TOKEN=
METAS_API_DEMO_ACCOUNT_ID=
METAS_API_PROP_ACCOUNT_ID=

# --- Myfxbook -------------------------------------------------------
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
# Comma-separated session/account IDs of curated, audited gold leaders
MYFXBOOK_LEADERS=
MYFXBOOK_POLL_INTERVAL_SECONDS=300

# --- Kronos ---------------------------------------------------------
# Path to a trained Kronos checkpoint, or leave default to use the pretrained model
KRONOS_MODEL_PATH=
KRONOS_HORIZON=24
PREDICT_HORIZON_BARS=24

# --- Telegram alerts ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Model / backtest -----------------------------------------------
TRAIN_START=2020-01-01
TRAIN_END=2023-12-31
VALIDATION_START=2024-01-01
VALIDATION_END=2024-12-31
TEST_START=2025-01-01
TEST_END=2026-12-31

# Signal thresholds (tuned in Phase 4, not guessed)
META_MODEL_PROB_THRESHOLD=0.60
MIN_LEADER_SCORE=3.0

# --- Risk overrides --------------------------------------------------
RISK_CAPITAL_BASE=100000
POSITION_RISK_PERCENT=0.01
MAX_DRAWDOWN_PERCENT=0.06
DAILY_LOSS_LIMIT_PERCENT=0.03
KILL_SWITCH_ENABLED=true